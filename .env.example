# Copy to .env and fill in. .env is gitignored — never commit it.
SAP_USERNAME=
SAP_PASSWORD=

# Telegram delivery. Create a bot with @BotFather to get the token, then message
# your bot once and run `attendance telegram-setup` to discover your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used only to convert the exact class count into a rough day estimate.
CLASSES_PER_DAY=6

# --- Multi-user (friends) ---
# Anyone who finds the bot can register. Set an invite code and share it only
# with friends so strangers can't register and use your server. Leave blank to
# allow open registration.
ATTENDANCE_INVITE_CODE=

# Encryption key for stored friend passwords. Leave blank and the bot generates
# one into .secret_key on first run (fine for a single VPS). Set it explicitly
# only if you want to control/rotate the key yourself (a Fernet key).
ATTENDANCE_SECRET_KEY=

# --- Website (optional; see deploy/WEB.md) ---
# Setting WEB_PORT turns the site on. It takes SAP passwords, so only ever expose
# it through HTTPS. Put comments on their own line, never after a value.
WEB_PORT=
WEB_HOST=127.0.0.1
# Set to 1 only when a reverse proxy (Traefik) is in front, so client IPs for the
# login throttle come from the proxy's X-Forwarded-For.
WEB_TRUST_PROXY=
