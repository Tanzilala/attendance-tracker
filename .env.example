# Copy to .env and fill in. .env is gitignored — never commit it.
SAP_USERNAME=
SAP_PASSWORD=

# Telegram delivery. Create a bot with @BotFather to get the token, then message
# your bot once and run `attendance telegram-setup` to discover your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Used only to convert the exact class count into a rough day estimate.
CLASSES_PER_DAY=6
